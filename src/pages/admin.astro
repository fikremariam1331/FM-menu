---
import '../styles/global.css';

const getImgUrl = (path: string) => {
  if (!path) return '';
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  const base = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : import.meta.env.BASE_URL + '/';
  return `${base}${cleanPath}`;
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Orders</title>

    <link rel="apple-touch-icon" sizes="180x180" href={getImgUrl('/apple-touch-icon.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={getImgUrl('/favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={getImgUrl('/favicon-16x16.png')} />
    <link rel="manifest" href={getImgUrl('/site.webmanifest')} />
  </head>
  <body class="bg-[#F5F0E6] text-[#6B4430] font-sans antialiased min-h-screen">
    <!-- Login -->
    <section id="login" class="max-w-sm mx-auto mt-20 px-4">
      <div class="bg-white rounded-2xl shadow-md p-6 border-b-4 border-[#2E9E78]">
        <h1 class="text-2xl font-extrabold mb-4">Orders Login</h1>
        <label class="block font-bold mb-1" for="login-email">Email</label>
        <input id="login-email" type="email" class="w-full border-2 border-[#6B4430]/30 rounded-lg p-3 mb-4 focus:outline-none focus:border-[#2E9E78]" />
        
        <label class="block font-bold mb-1" for="login-password">Password</label>
        <div class="relative mb-3">
          <input id="login-password" type="password" class="w-full border-2 border-[#6B4430]/30 rounded-lg p-3 pr-12 focus:outline-none focus:border-[#2E9E78]" />
          <button type="button" id="toggle-password" class="absolute right-3 top-3 text-gray-400 hover:text-[#6B4430] focus:outline-none" aria-label="Toggle password visibility">
            <!-- Eye Icon (Show) -->
            <svg id="eye-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </button>
        </div>

        <p id="login-error" class="hidden text-red-600 text-sm font-semibold mb-2"></p>
        <button id="login-btn" type="button" class="w-full bg-[#2E9E78] text-white font-bold rounded-lg py-3 text-lg">Sign in</button>
      </div>
    </section>

    <!-- Dashboard -->
    <section id="dashboard" class="hidden">
      <header class="sticky top-0 z-10 bg-[#6B4430] border-b-4 border-[#2E9E78]">
        <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
          <h1 class="text-[#F5B800] text-xl font-extrabold">Orders</h1>
          <button id="logout-btn" type="button" class="bg-white text-[#6B4430] font-bold rounded-lg px-3 py-2 text-sm">Sign out</button>
        </div>
      </header>

      <main class="max-w-3xl mx-auto px-4 py-4">
        <p id="permission-error" class="hidden bg-red-100 text-red-700 font-semibold rounded-lg p-3 mb-4">
          This account is not allowed to view orders.
        </p>

        <div class="grid grid-cols-3 gap-3 mb-4">
          <div class="bg-white rounded-xl shadow-md p-3 text-center border-b-4 border-[#2E9E78]">
            <p class="text-xs font-bold">Today's sales</p>
            <p class="text-xl font-extrabold text-[#2E9E78]"><span id="stat-sales">0</span> ETB</p>
          </div>
          <div class="bg-white rounded-xl shadow-md p-3 text-center border-b-4 border-[#2E9E78]">
            <p class="text-xs font-bold">Paid today</p>
            <p id="stat-paid" class="text-xl font-extrabold">0</p>
          </div>
          <div class="bg-white rounded-xl shadow-md p-3 text-center border-b-4 border-[#F5B800]">
            <p class="text-xs font-bold">Open orders</p>
            <p id="stat-open" class="text-xl font-extrabold">0</p>
          </div>
        </div>

        <div class="flex gap-2 mb-4 overflow-x-auto">
          <button type="button" data-filter="active" class="rounded-lg px-3 py-2 text-sm font-bold bg-[#6B4430] text-white">Active</button>
          <button type="button" data-filter="paid" class="rounded-lg px-3 py-2 text-sm font-bold bg-white text-[#6B4430]">Paid today</button>
          <button type="button" data-filter="cancelled" class="rounded-lg px-3 py-2 text-sm font-bold bg-white text-[#6B4430]">Cancelled</button>
          <button type="button" data-filter="all" class="rounded-lg px-3 py-2 text-sm font-bold bg-white text-[#6B4430]">All</button>
        </div>

        <div id="orders-list" class="space-y-4"></div>
        <p id="empty" class="hidden text-center text-gray-500 py-10">No orders here yet.</p>
      </main>
    </section>

    <!-- Cancellation Modal -->
    <div id="cancel-modal" class="fixed inset-0 z-[80] hidden items-center justify-center bg-black/50 px-4">
      <div class="bg-white rounded-2xl w-full max-w-sm p-6 relative">
        <button id="close-cancel-modal" class="absolute top-3 right-4 text-2xl leading-none text-black" aria-label="Close">✕</button>
        
        <h3 class="text-2xl font-extrabold text-[#6B4430] mb-2">Cancel Order</h3>
        <p class="text-sm text-gray-500 mb-4">Please provide a reason. This will be sent to the customer via WhatsApp.</p>
        
        <textarea id="cancel-reason" rows="3" class="w-full border-2 border-[#6B4430]/30 rounded-lg p-3 text-gray-800 focus:outline-none focus:border-red-500 mb-4" placeholder="e.g., Item is out of stock, kitchen is closed..."></textarea>
        
        <button id="confirm-cancel-btn" class="w-full bg-red-600 text-white font-bold rounded-lg py-3 hover:bg-red-700 transition-colors">
          Confirm Cancellation
        </button>
      </div>
    </div>

    <script>
      import { db } from '../lib/firebase';
      import { getApp } from 'firebase/app';
      import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut } from 'firebase/auth';
      import { collection, query, orderBy, limit, onSnapshot, doc, updateDoc, serverTimestamp } from 'firebase/firestore';

      type Line = { name: string; qty: number; price: number };
      type Order = {
        id: string;
        customer: string;
        phone: string;
        items: Line[];
        total: number;
        status: string;
        createdAt: any;
        paidAt: any;
        cancelReason?: string;
      };

      const auth = getAuth(getApp());
      const $ = (id: string) => document.getElementById(id) as HTMLElement;

      let orders: Order[] = [];
      let filter = 'active';
      let unsubscribe: (() => void) | null = null;
      let firstLoad = true;

      const toDate = (t: any): Date | null => (t && typeof t.toDate === 'function' ? t.toDate() : null);
      const isToday = (d: Date | null) => !!d && d.toDateString() === new Date().toDateString();
      const fmt = (d: Date | null) =>
        d ? d.toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : '...';

      const orderCode = (id: string) => id; // The ID is already perfectly formatted (e.g., JD-11-2-001)

      function beep() {
        try {
          const Ctx = (window as any).AudioContext || (window as any).webkitAudioContext;
          const ctx = new Ctx();
          const osc = ctx.createOscillator();
          osc.frequency.value = 880;
          osc.connect(ctx.destination);
          osc.start();
          setTimeout(() => {
            osc.stop();
            ctx.close();
          }, 300);
        } catch (e) {}
      }

      // ---------- Toggle Password Visibility ----------
      const togglePasswordBtn = document.getElementById('toggle-password');
      const passwordInput = document.getElementById('login-password') as HTMLInputElement;
      const eyeIcon = document.getElementById('eye-icon');

      if (togglePasswordBtn && passwordInput && eyeIcon) {
        togglePasswordBtn.addEventListener('click', () => {
          const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
          passwordInput.setAttribute('type', type);
          
          if (type === 'text') {
            // Show crossed-out eye
            eyeIcon.innerHTML = `
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
            `;
          } else {
            // Show normal eye
            eyeIcon.innerHTML = `
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            `;
          }
        });
      }

      // ---------- WhatsApp reply ----------
      function waNumber(raw: string) {
        let d = String(raw || '').replace(/\D/g, '');
        if (d.startsWith('00')) d = d.slice(2);
        if (d.startsWith('251')) return d;
        if (d.startsWith('0')) return '251' + d.slice(1);
        if (d.length === 9) return '251' + d;
        return d;
      }

      function replyText(o: Order) {
        const code = orderCode(o.id);
        const name = o.customer;
        const total = o.total + ' ETB';
        switch (o.status) {
          case 'Confirmed':
            return 'Hello ' + name + ' 👋\n✅ Your order *' + code + '* is confirmed. We are preparing it now.\n\n💰 Total: *' + total + '*\nThank you! 🙏';
          case 'Ready':
            return 'Hello ' + name + ' 👋\n🍽️ Your order *' + code + '* is ready.\n\n💰 Total: *' + total + '*\nThank you! 🙏';
          case 'Paid':
            return 'Hello ' + name + ' 👋\n🙏 Thank you! We received your payment of *' + total + '* for order *' + code + '*.';
          case 'Cancelled':
            const reasonText = o.cancelReason ? `\n*Reason:* ${o.cancelReason}\n` : '';
            return 'Hello ' + name + ' 👋\nSorry, your order *' + code + '* was cancelled.' + reasonText + '\nPlease contact us if you have any questions.';
          default:
            return 'Hello ' + name + ' 👋\nWe received your order *' + code + '*. We will confirm it shortly.\n\n💰 Total: *' + total + '*';
        }
      }

      // ---------- Login ----------
      async function doLogin() {
        const email = (document.getElementById('login-email') as HTMLInputElement).value.trim();
        const password = passwordInput.value;
        const err = $('login-error');
        err.classList.add('hidden');
        try {
          await signInWithEmailAndPassword(auth, email, password);
        } catch (e) {
          err.textContent = 'Wrong email or password.';
          err.classList.remove('hidden');
        }
      }
      $('login-btn').addEventListener('click', doLogin);
      passwordInput.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter') doLogin();
      });
      $('logout-btn').addEventListener('click', () => signOut(auth));

      onAuthStateChanged(auth, (user) => {
        if (user) {
          $('login').classList.add('hidden');
          $('dashboard').classList.remove('hidden');
          startListening();
        } else {
          if (unsubscribe) {
            unsubscribe();
            unsubscribe = null;
          }
          orders = [];
          firstLoad = true;
          $('dashboard').classList.add('hidden');
          $('login').classList.remove('hidden');
        }
      });

      // ---------- Live orders ----------
      function startListening() {
        if (unsubscribe) return;
        const q = query(collection(db, 'orders'), orderBy('createdAt', 'desc'), limit(300));
        unsubscribe = onSnapshot(
          q,
          (snap) => {
            if (!firstLoad && snap.docChanges().some((c) => c.type === 'added' && !c.doc.metadata.hasPendingWrites)) {
              beep();
            }
            firstLoad = false;
            orders = snap.docs.map((d) => ({ id: d.id, ...(d.data() as any) }));
            render();
          },
          () => {
            $('permission-error').classList.remove('hidden');
          }
        );
      }

      async function setStatus(id: string, status: string) {
        try {
          await updateDoc(doc(db, 'orders', id), {
            status: status,
            paidAt: status === 'Paid' ? serverTimestamp() : null,
          });
        } catch (e) {
          alert('Could not update the order. Please check your connection.');
        }
      }

      // ---------- Filters ----------
      document.querySelectorAll<HTMLElement>('[data-filter]').forEach((b) => {
        b.addEventListener('click', () => {
          filter = b.dataset.filter || 'active';
          document.querySelectorAll<HTMLElement>('[data-filter]').forEach((x) => {
            const on = x === b;
            x.classList.toggle('bg-[#6B4430]', on);
            x.classList.toggle('text-white', on);
            x.classList.toggle('bg-white', !on);
            x.classList.toggle('text-[#6B4430]', !on);
          });
          render();
        });
      });

      // ---------- Display ----------
      const badge: Record<string, string> = {
        New: 'bg-[#F5B800] text-[#6B4430]',
        Confirmed: 'bg-purple-100 text-purple-800',
        Ready: 'bg-blue-100 text-blue-800',
        Paid: 'bg-[#2E9E78] text-white',
        Cancelled: 'bg-gray-200 text-gray-600',
      };

      function makeButton(label: string, cls: string, onClick: () => void) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.className = 'rounded-lg px-4 py-2 font-bold text-sm ' + cls;
        b.addEventListener('click', onClick);
        return b;
      }

      function isOpen(s: string) {
        return s === 'New' || s === 'Confirmed' || s === 'Ready';
      }

      // ---------- Cancellation Logic ----------
      let activeCancelOrder: Order | null = null;
      const cancelModal = $('cancel-modal');
      const cancelReasonInput = document.getElementById('cancel-reason') as HTMLTextAreaElement;
      const confirmCancelBtn = document.getElementById('confirm-cancel-btn') as HTMLButtonElement;
      const closeCancelModalBtn = $('close-cancel-modal');

      (window as any).openCancelModal = function(order: Order) {
        activeCancelOrder = order;
        cancelReasonInput.value = '';
        cancelModal.classList.remove('hidden');
        cancelModal.classList.add('flex');
      };

      function closeCancelModal() {
        cancelModal.classList.add('hidden');
        cancelModal.classList.remove('flex');
        activeCancelOrder = null;
      }

      closeCancelModalBtn.addEventListener('click', closeCancelModal);
      cancelModal.addEventListener('click', (e) => {
        if (e.target === cancelModal) closeCancelModal();
      });

      confirmCancelBtn.addEventListener('click', async () => {
        if (!activeCancelOrder) return;
        
        const reason = cancelReasonInput.value.trim();
        if (!reason) {
          alert("Please enter a reason for cancellation.");
          return;
        }

        confirmCancelBtn.disabled = true;
        confirmCancelBtn.textContent = "Cancelling...";

        try {
          // Update Firebase with new status AND the reason
          await updateDoc(doc(db, 'orders', activeCancelOrder.id), {
            status: 'Cancelled',
            cancelReason: reason,
          });

          // Send WhatsApp message automatically
          const phone = waNumber(activeCancelOrder.phone);
          const code = orderCode(activeCancelOrder.id);
          const message = `Hello ${activeCancelOrder.customer} 👋\nSorry, your order *${code}* was cancelled.\n\n*Reason:* ${reason}\n\nPlease contact us if you have any questions.`;
          
          window.open(`https://wa.me/${phone}?text=${encodeURIComponent(message)}`, '_blank');

          closeCancelModal();
        } catch (error) {
          console.error("Error cancelling order: ", error);
          alert("Could not cancel the order. Check your internet connection.");
        } finally {
          confirmCancelBtn.disabled = false;
          confirmCancelBtn.textContent = "Confirm Cancellation";
        }
      });

      function render() {
        const paidToday = orders.filter((o) => o.status === 'Paid' && isToday(toDate(o.paidAt)));
        $('stat-sales').textContent = String(paidToday.reduce((s, o) => s + o.total, 0));
        $('stat-paid').textContent = String(paidToday.length);
        $('stat-open').textContent = String(orders.filter((o) => isOpen(o.status)).length);

        const shown = orders.filter((o) => {
          if (filter === 'active') return isOpen(o.status);
          if (filter === 'paid') return o.status === 'Paid' && isToday(toDate(o.paidAt));
          if (filter === 'cancelled') return o.status === 'Cancelled';
          return true;
        });

        const list = $('orders-list');
        list.innerHTML = '';
        $('empty').classList.toggle('hidden', shown.length > 0);

        shown.forEach((o) => {
          const items = o.items || [];
          const card = document.createElement('div');
          card.className = 'bg-white rounded-xl shadow-md p-4 border-l-4 border-[#2E9E78]';

          const top = document.createElement('div');
          top.className = 'flex items-center justify-between mb-2 gap-2';
          const code = document.createElement('span');
          code.className = 'text-xl font-extrabold tracking-wider';
          code.textContent = '#' + orderCode(o.id);
          const st = document.createElement('span');
          st.className = 'rounded-full px-3 py-1 text-sm font-bold ' + (badge[o.status] || badge.New);
          st.textContent = o.status;
          top.append(code, st);

          const who = document.createElement('p');
          who.className = 'font-bold';
          who.textContent = o.customer + ' · ';
          const tel = document.createElement('a');
          tel.href = 'tel:' + String(o.phone).replace(/[^\d+]/g, '');
          tel.className = 'text-[#2E9E78] underline';
          tel.textContent = o.phone;
          who.append(tel);

          const time = document.createElement('p');
          time.className = 'text-sm text-gray-500 mb-2';
          time.textContent = fmt(toDate(o.createdAt)) + (o.status === 'Paid' ? ' · paid ' + fmt(toDate(o.paidAt)) : '');

          const ul = document.createElement('ul');
          ul.className = 'border-t border-[#6B4430]/20 pt-2 mb-2 space-y-1';
          items.forEach((i) => {
            const li = document.createElement('li');
            li.className = 'flex justify-between';
            const a = document.createElement('span');
            a.textContent = i.qty + ' x ' + i.name;
            const b = document.createElement('span');
            b.textContent = i.qty * i.price + ' ETB';
            li.append(a, b);
            ul.append(li);
          });

          const totalRow = document.createElement('div');
          totalRow.className = 'flex justify-between font-extrabold text-lg border-t border-[#6B4430]/20 pt-2 mb-3';
          const tl = document.createElement('span');
          tl.textContent = 'Total';
          const tv = document.createElement('span');
          tv.className = 'text-[#2E9E78]';
          tv.textContent = o.total + ' ETB';
          totalRow.append(tl, tv);

          card.append(top, who, time, ul, totalRow);

          const calc = items.reduce((s, i) => s + i.qty * i.price, 0);
          if (calc !== o.total) {
            const warn = document.createElement('p');
            warn.className = 'bg-red-100 text-red-700 font-bold text-sm rounded-lg p-2 mb-3';
            warn.textContent = 'Warning: the total does not match the items (items add up to ' + calc + ' ETB). Check before marking as paid.';
            card.append(warn);
          }

          const actions = document.createElement('div');
          actions.className = 'flex flex-wrap gap-2';
          const green = 'bg-[#2E9E78] text-white';
          const gray = 'bg-gray-200 text-gray-700';
          if (o.status === 'New') {
            actions.append(makeButton('Confirm Order', green, () => setStatus(o.id, 'Confirmed')));
            actions.append(makeButton('Cancel', gray, () => (window as any).openCancelModal(o)));
          } else if (o.status === 'Confirmed') {
            actions.append(makeButton('Mark Ready', green, () => setStatus(o.id, 'Ready')));
            actions.append(makeButton('Cancel', gray, () => (window as any).openCancelModal(o)));
          } else if (o.status === 'Ready') {
            actions.append(makeButton('Mark Paid', green, () => setStatus(o.id, 'Paid')));
            actions.append(makeButton('Cancel', gray, () => (window as any).openCancelModal(o)));
          } else if (o.status === 'Paid') {
            actions.append(makeButton('Undo (back to Ready)', gray, () => setStatus(o.id, 'Ready')));
          } else {
            actions.append(makeButton('Restore', gray, () => setStatus(o.id, 'New')));
          }

          const reply = document.createElement('a');
          reply.href = 'https://api.whatsapp.com/send?phone=' + waNumber(o.phone) + '&text=' + encodeURIComponent(replyText(o));
          reply.target = '_blank';
          reply.rel = 'noopener';
          reply.className = 'rounded-lg px-4 py-2 font-bold text-sm bg-[#25D366] text-white';
          reply.textContent = 'Reply on WhatsApp';
          actions.append(reply);

          card.append(actions);

          list.append(card);
        });
      }
    </script>
  </body>
</html>